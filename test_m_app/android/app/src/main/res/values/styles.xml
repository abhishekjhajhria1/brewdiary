<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- The window while the process starts: the Android 12+ system splash (the app icon
         on the house's night colour), then the same colour until Flutter's first frame.
         brewdiary is dark by default, so the launch is dark in both system themes. -->
    <style name="LaunchTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowBackground">@drawable/launch_background</item>
        <item name="android:windowSplashScreenBackground">@color/brewdiary_night</item>
        <item name="android:windowLayoutInDisplayCutoutMode">always</item>
    </style>
    <!-- The window behind the Flutter UI once it's running (seen for a frame while the
         keyboard resizes the view, so it matches the app's background). -->
    <style name="NormalTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowBackground">@color/brewdiary_night</item>
        <item name="android:windowLayoutInDisplayCutoutMode">always</item>
    </style>
</resources>
